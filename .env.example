POSTGRES_USER=commercecore
POSTGRES_PASSWORD=replace-with-a-long-unique-local-password
POSTGRES_DB=commercecore
COMMERCECORE_APP_PASSWORD=replace-with-a-long-unique-local-password

PGADMIN_DEFAULT_EMAIL=admin@example.test
PGADMIN_DEFAULT_PASSWORD=replace-with-a-long-unique-local-password

RABBITMQ_DEFAULT_USER=commercecore
RABBITMQ_DEFAULT_PASS=replace-with-a-long-unique-local-password

# Optional while the dispatcher is disabled. See docker/outbox/README.md.
# Use Host=postgres and Username=commercecore_outbox, never the migration admin.
COMMERCECORE_OUTBOX_CONNECTION_STRING=

RABBITMQ_PUBLISHER_USER=commercecore_publisher
RABBITMQ_PUBLISHER_PASSWORD=
